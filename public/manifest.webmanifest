{
  "id": "./",
  "name": "savDex",
  "short_name": "savDex",
  "description": "Veja a equipe e o PC do seu save de Pokémon (Quetzal, Emerald, FireRed/LeafGreen) e exporte em CSV, Showdown ou JSON. Funciona offline; o save não sai do aparelho.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#222a44",
  "theme_color": "#2b3350",
  "categories": ["games", "utilities"],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "save", "accept": ["application/octet-stream", ".sav", "*/*"] }]
    }
  },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
